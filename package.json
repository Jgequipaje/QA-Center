{
  "name": "@purr/qa-center",
  "version": "0.1.0",
  "description": "A local QA issue tracker that sits in the corner of your web app. JSON-persisted, zero database.",
  "type": "module",
  "bin": {
    "qa-center": "./bin/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "cross-env BUILD_MODE=lib vite build && tsc -p tsconfig.lib.json",
    "build": "tsc -b && vite build",
    "build:lib": "cross-env BUILD_MODE=lib vite build && tsc -p tsconfig.lib.json",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview",
    "qa:server": "node bin/cli.js",
    "qa:start": "node bin/cli.js",
    "qa:dev": "vite",
    "server": "node bin/cli.js",
    "start": "node bin/cli.js"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "open": "^10.1.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "keywords": [
    "qa",
    "issue-tracker",
    "dev-tool",
    "playwright",
    "local"
  ],
  "license": "MIT"
}
